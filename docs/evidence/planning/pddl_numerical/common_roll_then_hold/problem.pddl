(define (problem numerical_hedge_plan_common_roll_then_hold-problem)
 (:domain numerical_hedge_plan_common_roll_then_hold-domain)
 (:init
              (position_open)
              (rehedge_allowed)
              (roll_required)
              (hold_allowed)
              (= (current_contracts) 3)
              (= (target_contracts) 3)
              (= (executable_contracts) 3)
              (= (margin_available_amount) 2000000)
              (= (margin_required_amount) 0)
              (= (transaction_cost_micros) 0)
              (= (max_transaction_cost_micros) 5000)
              (= (days_to_expiry) 2)
 )
 (:goal (and 
           (decision_completed)
           (or (not (position_open)) (not (roll_required)) (roll_completed))
        )
 )
)
