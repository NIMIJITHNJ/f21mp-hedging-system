(define (problem hedge_plan_demo_hold_position-problem)
 (:domain hedge_plan_demo_hold_position-domain)
 (:init
              (position_open)
              (margin_available)
              (rehedge_allowed)
              (hold_allowed)
              (= (current_hedge_bps) 85)
              (= (target_hedge_bps) 85)
              (= (max_hedge_bps) 150)
              (= (estimated_trade_cost_micros) 0)
              (= (max_trade_cost_micros) 250)
 )
 (:goal (and 
           (decision_completed)
           (or (not (position_open)) (not (roll_required)) (roll_completed))
        )
 )
)
